      "created": 1795165650660,
      "link": null,
      "locked": false,
      "text": "[student@workstation ~]$ oc get gateway/data-science-gateway -n openshift-ingress -o yaml\n\napiVersion: gateway.networking.k8s.io/v1\nkind: Gateway\nmetadata:\n  annotations:\n...\n  labels:\n    istio.io/rev: openshift-gateway\n    platform.opendatahub.io/part-of: gatewayconfig\n  name: data-science-gateway\n\n  namespace: openshift-ingress\n\n...\n\nspec:\n  gatewayClassName: data-science-gateway-class\n  infrastructure:\n    parametersRef:\n      group: \"\"\n      kind: ConfigMap\n      name: data-science-gateway-config\n  listeners:\n  - allowedRoutes:\n      namespaces:\n        from: Selector\n        selector:\n          matchExpressions:\n          - key: kubernetes.io/metadata.name\n            operator: In\n            values:\n            - openshift-ingress\n            - redhat-ods-applications\n    name: https\n    port: 443\n    protocol: HTTPS\n    tls:\n      certificateRefs:\n      - group: \"\"\n        kind: Secret\n        name: data-science-gateway-service-tls\n      mode: Terminate",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation ~]$ oc get gateway/data-science-gateway -n openshift-ingress -o yaml\n\napiVersion: gateway.networking.k8s.io/v1\nkind: Gateway\nmetadata:\n  annotations:\n...\n  labels:\n    istio.io/rev: openshift-gateway\n    platform.opendatahub.io/part-of: gatewayconfig\n  name: data-science-gateway\n\n  namespace: openshift-ingress\n\n...\n\nspec:\n  gatewayClassName: data-science-gateway-class\n  infrastructure:\n    parametersRef:\n      group: \"\"\n      kind: ConfigMap\n      name: data-science-gateway-config\n  listeners:\n  - allowedRoutes:\n      namespaces:\n        from: Selector\n        selector:\n          matchExpressions:\n          - key: kubernetes.io/metadata.name\n            operator: In\n            values:\n            - openshift-ingress\n            - redhat-ods-applications\n    name: https\n    port: 443\n    protocol: HTTPS\n    tls:\n      certificateRefs:\n      - group: \"\"\n        kind: Secret\n        name: data-science-gateway-service-tls\n      mode: Terminate",
      "autoResize": true,
