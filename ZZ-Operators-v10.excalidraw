      "link": null,
      "locked": false,
      "text": "[student@workstation ~]$ oc get odhdashboardconfigs odh-dashboard-config -n \\\n    redhat-ods-applications -o yaml\napiVersion: opendatahub.io/v1alpha\nkind: OdhDashboardConfig\nmetadata:\n  annotations:\n    ...\n\n  labels:\n    ...\n\n  name: odh-dashboard-config\n  namespace: redhat-ods-applications\n\nspec:\n\n  dashboardConfig:\n    disableLMEval: false\n    disableTracking: false\n\n  hardwareProfileOrder: []\n\n  notebookController:\n    enabled: true\n    notebookNamespace: rhods-notebooks\n    pvcSize: 20Gi\n\n  templateDisablement: []\n  templateOrder: []",
      "fontSize": 36,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation ~]$ oc get odhdashboardconfigs odh-dashboard-config -n \\\n    redhat-ods-applications -o yaml\napiVersion: opendatahub.io/v1alpha\nkind: OdhDashboardConfig\nmetadata:\n  annotations:\n    ...\n\n  labels:\n    ...\n\n  name: odh-dashboard-config\n  namespace: redhat-ods-applications\n\nspec:\n\n  dashboardConfig:\n    disableLMEval: false\n    disableTracking: false\n\n  hardwareProfileOrder: []\n\n  notebookController:\n    enabled: true\n    notebookNamespace: rhods-notebooks\n    pvcSize: 20Gi\n\n  templateDisablement: []\n  templateOrder: []",
