      "updated": 1795176687032,
      "link": null,
      "locked": false,
      "text": "--> First, we have the Red Hat OpenShift AI Operator :\n\n\n\n        ° This is installed like all the other Operators \n          through the Operator Hub, \n        and \n        ° it is available there for download\n\n ",
      "fontSize": 36,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "--> First, we have the Red Hat OpenShift AI Operator :\n\n\n\n        ° This is installed like all the other Operators \n          through the Operator Hub, \n        and \n        ° it is available there for download\n\n ",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1793179358837,
      "labelPosition": null,
      "baseFontSize": null
