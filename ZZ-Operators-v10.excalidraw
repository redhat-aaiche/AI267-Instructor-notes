      "text": "[student@workstation ~]$ cat postgres.yaml \napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  labels:\n    app: llamadb\n  name: llamadb\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: llamadb\n  template:\n    metadata:\n      labels:\n        app: llamadb\n    spec:\n      containers:\n      - env:\n        - name: POSTGRESQL_DATABASE\n          value: llamastack\n        - name: POSTGRESQL_USER\n          value: llamastack\n        - name: POSTGRESQL_PASSWORD\n          value: llamastack\n        image: registry.lab.example.com:8443/redhattraining/sclorg/postgresql-15-c9s:20260218\n        name: postgresql\n        ports:\n        - containerPort: 5432\n        readinessProbe:\n          exec:\n            command:\n            - /bin/sh\n            - -c\n            - pg_isready -U llamastack -d llamastack\n          initialDelaySeconds: 5\n          periodSeconds: 5\n---\napiVersion: v1\nkind: Service\nmetadata:\n  labels:\n    app: llamadb\n  name: llamadb\nspec:\n  ports:\n  - port: 5432\n    targetPort: 5432\n  selector:\n    app: llamadb\n---",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[student@workstation ~]$ cat postgres.yaml \napiVersion: apps/v1\nkind: Deployment\nmetadata:\n  labels:\n    app: llamadb\n  name: llamadb\nspec:\n  replicas: 1\n  selector:\n    matchLabels:\n      app: llamadb\n  template:\n    metadata:\n      labels:\n        app: llamadb\n    spec:\n      containers:\n      - env:\n        - name: POSTGRESQL_DATABASE\n          value: llamastack\n        - name: POSTGRESQL_USER\n          value: llamastack\n        - name: POSTGRESQL_PASSWORD\n          value: llamastack\n        image: registry.lab.example.com:8443/redhattraining/sclorg/postgresql-15-c9s:20260218\n        name: postgresql\n        ports:\n        - containerPort: 5432\n        readinessProbe:\n          exec:\n            command:\n            - /bin/sh\n            - -c\n            - pg_isready -U llamastack -d llamastack\n          initialDelaySeconds: 5\n          periodSeconds: 5\n---\napiVersion: v1\nkind: Service\nmetadata:\n  labels:\n    app: llamadb\n  name: llamadb\nspec:\n  ports:\n  - port: 5432\n    targetPort: 5432\n  selector:\n    app: llamadb\n---",
